__version__: str

type _Num = mpf | int | float | str

class mpf:
    def __new__(cls, x: _Num = ..., **kwargs: object) -> mpf: ...
    def __add__(self, other: _Num) -> mpf: ...
    def __radd__(self, other: _Num) -> mpf: ...
    def __sub__(self, other: _Num) -> mpf: ...
    def __rsub__(self, other: _Num) -> mpf: ...
    def __mul__(self, other: _Num) -> mpf: ...
    def __rmul__(self, other: _Num) -> mpf: ...
    def __truediv__(self, other: _Num) -> mpf: ...
