# Q1: a machine with no GPU and no driver -- no /dev/dxg, no /dev/nvidia*, no libcuda.
# Run WITHOUT --gpus. Mirrors a GitHub-hosted ubuntu runner closely enough for the question.
#
#   docker build -f Dockerfile.nogpu --build-context brotkit=../.. -t s4-nogpu .
#   docker run --rm -e CUDA_VISIBLE_DEVICES= -v "$PWD/results:/s4/results" s4-nogpu
FROM debian:bookworm-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_INSTALL_DIR=/opt/python UV_PROJECT_ENVIRONMENT=/venv
WORKDIR /s4
COPY pyproject.toml uv.lock ./
RUN uv sync -p 3.15 --frozen
# brotkit itself (for resource_usage), installed without the [cuda] extra's GPU needs beyond
# the wheels already present: it reuses the venv's numba-cuda-mlir.
COPY --from=brotkit pyproject.toml README.md LICENSE /brotkit/
COPY --from=brotkit src /brotkit/src
RUN uv pip install --python /venv/bin/python --no-deps -e /brotkit
COPY gen.py q1_nogpu.py ./
CMD ["/venv/bin/python", "q1_nogpu.py", "nogpu-container"]
